# ─── Server ───
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── PostgreSQL ───
# The app connects as `app_user` (non-superuser) so RLS is always enforced
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/saas_mt
# Admin connection bypasses RLS — used only for migrations and admin operations
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/saas_mt

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Rate Limiting (per minute) ───
RATE_LIMIT_FREE=60
RATE_LIMIT_PRO=600
RATE_LIMIT_ENTERPRISE=6000

# ─── Usage Metering ───
USAGE_FLUSH_INTERVAL_MS=300000
